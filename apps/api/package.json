{
  "name": "@fettle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "cross-env NODE_ENV=production tsx src/server.ts",
    "db": "tsx scripts/embedded-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:demo": "tsx scripts/demo-data.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.1",
    "@fastify/static": "^10.1.5",
    "@fettle/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "embedded-postgres": "18.4.0-beta.17",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
