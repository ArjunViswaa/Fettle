# Copy to .env and adjust (`npm run setup` does this for you on first run).

# Database. By default Fettle runs its own PostgreSQL server, with its data in .data/postgres
# (git-ignored), so nothing else needs installing. Connect a tool like DBeaver with:
#   host localhost, port EMBEDDED_PG_PORT, database fettle, user postgres, password EMBEDDED_PG_PASSWORD
EMBEDDED_PG_PORT=54330
# Generated on first run.
EMBEDDED_PG_PASSWORD=

# Or point Fettle at another PostgreSQL 14+ server instead (then the built-in one isn't started).
# `npm run db:setup` creates a `fettle` role and database on a server you have a superuser for.
# DATABASE_URL=postgres://fettle:password@127.0.0.1:5432/fettle

API_PORT=4100
API_HOST=127.0.0.1

# Public URL the browser uses to reach the app. Defaults: http://localhost:5174 in dev,
# http://localhost:4100 with `npm start`. Set it (and API_HOST=0.0.0.0) to open Fettle from your phone
# on the same Wi-Fi, e.g. APP_URL=http://192.168.1.20:4100
# APP_URL=

# Required. Generated on first run.
BETTER_AUTH_SECRET=

# Anyone who can reach the server may create an account. Set to false once everyone has signed up.
ALLOW_SIGNUP=true
