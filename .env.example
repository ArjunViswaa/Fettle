# Copy to .env and adjust (`npm run setup` does this for you on first run).

# Your local PostgreSQL server. `npm run db:setup` creates a dedicated `fettle` role and database
# on it and fills this line in. Any PostgreSQL 14+ works.
DATABASE_URL=

API_PORT=4100
API_HOST=127.0.0.1

# Public URL the browser uses to reach the app. Defaults: http://localhost:5174 in dev,
# http://localhost:4100 with `npm start`. Set it (and API_HOST=0.0.0.0) to open Fettle from your phone
# on the same Wi-Fi, e.g. APP_URL=http://192.168.1.20:4100
# APP_URL=

# Required. `npm run setup` generates one.
BETTER_AUTH_SECRET=

# Anyone who can reach the server may create an account. Set to false once everyone has signed up.
ALLOW_SIGNUP=true
